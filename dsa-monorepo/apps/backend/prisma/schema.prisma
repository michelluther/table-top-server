// ============================================================================
// NextAuth.js Models
// ============================================================================
// These models are used by NextAuth.js for authentication and session management.
// The auth_user table (defined above) is used as the User table.

/// OAuth account model for NextAuth.js
model Account {
  id                String    @id @default(cuid())
  userId            Int       @map("user_id")
  type              String
  provider          String
  providerAccountId String    @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

/// Session model for NextAuth.js database sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime

  user auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

/// Verification token for email verification and password reset
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}
