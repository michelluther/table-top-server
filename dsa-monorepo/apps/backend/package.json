    "@types/better-sqlite3": "^7.6.13",
    "autoprefixer": "^10.4.27",
    "better-sqlite3": "^12.8.0",
    "next": "~16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8.5.8",
    "prisma": "^7.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
