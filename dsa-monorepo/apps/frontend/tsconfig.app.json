  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/frontend",
    "module": "es2015",
    "baseUrl": "src",
    "types": []
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts"
